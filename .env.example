DOMAIN=localhost
PUBLIC_SCHEME=http
SERVER_NAME=messagerie.gov.bf

POSTGRES_USER=synapse
POSTGRES_PASSWORD=change-me-demo
POSTGRES_DB=synapse

# true uniquement en mode autonome de la partie A (sans Keycloak) ; false = connexion par Keycloak seulement
SYNAPSE_PASSWORD_LOGIN=false
OIDC_SYNAPSE_SECRET=change-me-oidc
SYNAPSE_REGISTRATION_SHARED_SECRET=change-me-registration

# Partie B : identité et gouvernance (valeurs fictives de démonstration)
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
OAUTH2_PROXY_CLIENT_SECRET=change-me-oauth2-proxy
CONSOLE_ADMIN_CLIENT_SECRET=change-me-console-admin
# Exactement 16, 24 ou 32 caractères
OAUTH2_PROXY_COOKIE_SECRET=demo-cookie-secret-32-octets-ok!
# false uniquement en démonstration http ; true en production (https)
OAUTH2_PROXY_COOKIE_SECURE=false
